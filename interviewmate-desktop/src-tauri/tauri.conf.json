{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InterviewMate AI",
  "version": "0.1.0",
  "identifier": "ai.interviewmate.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "InterviewMate AI", "width": 1280, "height": 820, "minWidth": 900, "minHeight": 600, "contentProtected": true }],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8765 ipc: http://ipc.localhost; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; media-src 'self' blob:"
    }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico"] }
}
